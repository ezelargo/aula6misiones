<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>

        <!-- 0) No tocar la validacion de Let's Encrypt (renovacion del SSL) -->
        <rule name="ACME challenge" stopProcessing="true">
          <match url="^\.well-known/acme-challenge/" />
          <action type="None" />
        </rule>

        <!-- Ocultar el archivo de estado que genera el deploy automatico -->
        <rule name="Ocultar estado de deploy" stopProcessing="true">
          <match url="^\.ftp-deploy-sync-state\.json$" />
          <action type="CustomResponse" statusCode="404" statusReason="Not Found" statusDescription="Not Found" />
        </rule>

        <!-- 1) Dominio canonico: forzar HTTPS y quitar www (en una sola redireccion 301) -->
        <rule name="Canonico https sin www" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAny">
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{HTTP_HOST}" pattern="^www\." />
          </conditions>
          <action type="Redirect"
                  url="https://aula6misiones.com.ar/{R:1}"
                  redirectType="Permanent"
                  appendQueryString="true" />
        </rule>

        <!-- 2) Raiz -> Google Doc (302 temporal, para poder reemplazarlo por la web despues) -->
        <rule name="Raiz a Google Doc" stopProcessing="true">
          <match url="^$" />
          <action type="Redirect"
                  url="https://docs.google.com/document/d/1lhFKivX0y5_yqZ9_5j4KnIJVhsmM8H_BXOlijv6CZRg/edit?tab=t.0#heading=h.ym7osoeah8hf"
                  redirectType="Found" />
        </rule>

      </rules>
    </rewrite>
  </system.webServer>
</configuration>
