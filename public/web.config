<?xml version="1.0" encoding="UTF-8"?>
<configuration>
  <system.webServer>
    <rewrite>
      <rules>

        <!-- 0) No tocar la validacion de Let's Encrypt (renovacion del SSL) -->
        <rule name="ACME challenge" stopProcessing="true">
          <match url="^\.well-known/acme-challenge/" />
          <action type="None" />
        </rule>

        <!-- 1) Dominio canonico: forzar HTTPS y quitar www (en una sola redireccion 301) -->
        <rule name="Canonico https sin www" stopProcessing="true">
          <match url="(.*)" />
          <conditions logicalGrouping="MatchAny">
            <add input="{HTTPS}" pattern="^OFF$" />
            <add input="{HTTP_HOST}" pattern="^www\." />
          </conditions>
          <action type="Redirect"
                  url="https://aula6misiones.com.ar/{R:1}"
                  redirectType="Permanent"
                  appendQueryString="true" />
        </rule>

      </rules>
    </rewrite>

    <!-- Paginas: cache corto, para que los cambios se vean rapido -->
    <staticContent>
      <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="0.00:05:00" />
    </staticContent>

    <!-- Pagina 404 propia del sitio. Modo File: devuelve codigo 404 real
         (ExecuteURL devolvia 200). La ruta es relativa a este web.config. -->
    <httpErrors errorMode="Custom" existingResponse="Replace">
      <remove statusCode="404" subStatusCode="-1" />
      <error statusCode="404" path="404.html" responseMode="File" />
    </httpErrors>
  </system.webServer>

  <!-- Assets de Astro: el nombre cambia en cada build, se pueden cachear 1 año -->
  <location path="_astro">
    <system.webServer>
      <staticContent>
        <clientCache cacheControlMode="UseMaxAge" cacheControlMaxAge="365.00:00:00" />
      </staticContent>
    </system.webServer>
  </location>
</configuration>
