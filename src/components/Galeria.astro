---
import { Image, getImage } from 'astro:assets';
import { fotosDe } from '../lib/fotos';

interface Props {
  carpeta: string;
  titulo: string; // se usa para el texto alternativo
}

const { carpeta, titulo } = Astro.props;
const fotos = fotosDe(carpeta);

// Versión grande (para ver en pantalla completa con el Visor) de cada foto
const grandes = await Promise.all(fotos.map((src) => getImage({ src, width: 1600, format: 'webp' })));
---

{
  fotos.length > 0 && (
    <ul class="galeria" data-galeria>
      {fotos.map((src, i) => (
        <li>
          <a href={grandes[i].src} data-grande>
            <Image
              src={src}
              alt={`${titulo} – foto ${i + 1} de ${fotos.length}`}
              widths={[320, 640]}
              sizes="(min-width: 820px) 260px, 45vw"
              format="webp"
              loading="lazy"
            />
          </a>
        </li>
      ))}
    </ul>
  )
}

<style>
  .galeria {
    list-style: none;
    margin: 1.5rem 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(150px, 1fr));
    gap: 0.6rem;
  }

  .galeria a {
    display: block;
    border-radius: 10px;
    overflow: hidden;
    aspect-ratio: 4 / 3;
    background: var(--borde);
  }

  .galeria img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.3s;
  }

  .galeria a:hover img,
  .galeria a:focus-visible img {
    transform: scale(1.05);
  }
</style>
