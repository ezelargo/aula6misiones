---
interface Props {
  id: string; // id del video de YouTube
  titulo: string;
}

const { id, titulo } = Astro.props;
---

<div class="video">
  <iframe
    src={`https://www.youtube-nocookie.com/embed/${id}`}
    title={titulo}
    loading="lazy"
    allow="accelerometer; encrypted-media; gyroscope; picture-in-picture"
    allowfullscreen></iframe>
</div>

<style>
  .video {
    aspect-ratio: 16 / 9;
    border-radius: var(--radio);
    overflow: hidden;
    box-shadow: var(--sombra);
    margin-top: 1.5rem;
    max-width: 720px;
    background: #000;
  }

  iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
</style>
