---
import Base from '../layouts/Base.astro';
import Texto from '../components/Texto.astro';
---

<Base titulo="Cómo ayudar" descripcion="Necesidades y objetivos del Aula Satélite N° 6 de El Soberbio, Misiones. Conocé cómo podés colaborar.">
  <header class="encabezado-pagina">
    <div class="contenedor">
      <h1>Cómo ayudar</h1>
      <p>Buscamos fondos y donaciones de forma constante para cubrir las necesidades del aula. Cada aporte, grande o chico, hace la diferencia.</p>
    </div>
  </header>

  <section class="seccion">
    <div class="contenedor dos-columnas" style="align-items: start">
      <div class="tarjeta">
        <Texto id="necesidades" />
      </div>
      <div class="tarjeta">
        <Texto id="objetivos" />
      </div>
    </div>
  </section>

  <section class="seccion seccion--selva">
    <div class="contenedor" style="max-width: 760px; text-align: center">
      <h2>¿Querés colaborar?</h2>
      <p>
        Las donaciones y el padrinazgo se coordinan a través de <strong>APAER</strong>, la
        asociación que acompaña a escuelas rurales de todo el país y con la que trabajamos desde 2019.
      </p>
      <p class="aviso">
        Al contactarlos, mencioná que querés colaborar con el<br />
        <strong>Aula Satélite N° 6 de la Escuela N° 120 · El Soberbio, Misiones</strong>.
      </p>
      <div class="botones" style="justify-content: center">
        <a class="boton boton--claro" href="https://www.apaer.org.ar/">Contactar a APAER</a>
      </div>
    </div>
  </section>
</Base>

<style>
  .tarjeta {
    background: var(--blanco);
    border-radius: var(--radio);
    box-shadow: var(--sombra);
    padding: 1.75rem;
    height: 100%;
  }

  .aviso {
    background: rgb(255 255 255 / 0.12);
    border: 1px solid rgb(255 255 255 / 0.35);
    border-radius: var(--radio);
    padding: 1rem 1.25rem;
    margin: 1.5rem 0 0;
  }
</style>
