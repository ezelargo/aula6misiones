---
import Base from '../layouts/Base.astro';
---

<Base titulo="Página no encontrada" noindex>
  <section class="seccion">
    <div class="contenedor" style="text-align: center; max-width: 640px">
      <h1>Página no encontrada</h1>
      <p>La página que buscás no existe o cambió de lugar.</p>
      <div class="botones" style="justify-content: center">
        <a class="boton" href="/">Volver al inicio</a>
      </div>
    </div>
  </section>
</Base>
