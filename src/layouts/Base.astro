---
import '../styles/global.css';
import Visor from '../components/Visor.astro';

interface Props {
  titulo?: string;
  descripcion?: string;
  /** true en páginas que no deben aparecer en buscadores (ej. 404) */
  noindex?: boolean;
}

const {
  titulo,
  descripcion = 'Padrinazgo de una escuela rural de El Soberbio, Misiones: el Aula Satélite N° 6 de la Escuela N° 120 pasó de un aula de madera a un edificio de material gracias a padrinos y donantes. Conocé cómo ayudar.',
  noindex = false,
} = Astro.props;

const nombreSitio = 'Aula Satélite N° 6 · El Soberbio';
const tituloCompleto = titulo ? `${titulo} | ${nombreSitio}` : 'Padrinazgo del Aula Satélite N° 6 · El Soberbio, Misiones';
const ruta = Astro.url.pathname;
const urlCanonica = new URL(ruta, Astro.site).href;
const imagenCompartir = new URL('/og.jpg', Astro.site).href;
const esInicio = ruta === '/';

// Datos estructurados (schema.org) para buscadores, solo en el inicio
const datosEstructurados = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${Astro.site}#sitio`,
      url: Astro.site?.href,
      name: nombreSitio,
      inLanguage: 'es-AR',
    },
    {
      '@type': 'EducationalOrganization',
      '@id': `${Astro.site}#aula`,
      name: 'Aula Satélite N° 6 – Escuela N° 120',
      description: descripcion,
      url: Astro.site?.href,
      logo: new URL('/apple-touch-icon.png', Astro.site).href,
      image: imagenCompartir,
      address: {
        '@type': 'PostalAddress',
        addressLocality: 'El Soberbio',
        addressRegion: 'Misiones',
        addressCountry: 'AR',
      },
    },
  ],
};

const menu = [
  { href: '/', texto: 'Inicio' },
  { href: '/historia/', texto: 'Historia' },
  { href: '/como-ayudar/', texto: 'Cómo ayudar' },
  { href: '/agradecimientos/', texto: 'Agradecimientos' },
];
---

<!doctype html>
<html lang="es-AR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    {noindex ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={urlCanonica} />}
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-48.png" type="image/png" sizes="48x48" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <meta name="theme-color" content="#b4472a" />

    <!-- Vista previa al compartir (WhatsApp, Facebook, LinkedIn, X) -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={nombreSitio} />
    <meta property="og:url" content={urlCanonica} />
    <meta property="og:title" content={tituloCompleto} />
    <meta property="og:description" content={descripcion} />
    <meta property="og:locale" content="es_AR" />
    <meta property="og:image" content={imagenCompartir} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="La nueva aula de material del Aula Satélite N° 6 en El Soberbio, Misiones" />
    <meta name="twitter:card" content="summary_large_image" />

    {esInicio && <script type="application/ld+json" set:html={JSON.stringify(datosEstructurados)} />}
  </head>
  <body>
    <a class="saltar" href="#contenido">Saltar al contenido</a>

    <header class="cabecera">
      <div class="contenedor cabecera__fila">
        <a href="/" class="marca">
          <img class="marca__logo" src="/favicon.svg" alt="" width="42" height="42" />
          <span class="marca__texto">
            <strong>Aula Satélite N° 6</strong>
            <small>El Soberbio · Misiones</small>
          </span>
        </a>
        <nav aria-label="Principal">
          <ul class="menu">
            {
              menu.map((item) => (
                <li>
                  <a href={item.href} aria-current={ruta === item.href ? 'page' : undefined}>
                    {item.texto}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="contenido">
      <slot />
    </main>

    <footer class="pie">
      <div class="contenedor pie__fila">
        <div>
          <strong>Aula Satélite N° 6 – Escuela N° 120</strong>
          <p>El Soberbio, Misiones, Argentina. Proyecto sin fines de lucro, en colaboración con <a href="https://www.apaer.org.ar/">APAER</a>.</p>
        </div>
        <div class="pie__legal">
          <p>
            ¿Quién impulsa este proyecto? <a href="https://www.linkedin.com/in/ezelargo/">Perfil en LinkedIn</a>.
          </p>
          <p>
            Contenido bajo licencia <a href="https://creativecommons.org/licenses/by/4.0/deed.es">CC BY 4.0</a>.
            Código abierto en <a href="https://github.com/ezelargo/aula6misiones">GitHub</a>.
          </p>
        </div>
      </div>
    </footer>

    <Visor />
  </body>
</html>
